{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,

    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,

    "outDir": "./dist",
    "rootDir": ".",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },

  "include": [
    "src/**/*.ts",
    "generated/**/*.ts"
  ],

  "exclude": [
    "node_modules",
    "dist"
  ]
}