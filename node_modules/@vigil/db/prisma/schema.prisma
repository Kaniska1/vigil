generator client {
  provider               = "prisma-client"
  output                 = "../generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts        Account[]
  sessions        Session[]
  runs            Run[]
  orchestrations  OrchestrationRun[]
  publishedAgents Agent[]
  apiKeys         ApiKey[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model Agent {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String

  version String @default("1.0.0")

  capabilities String[] @default([])
  tools        String[] @default([])
  permissions  String[] @default([])

  inputSchema  Json?
  outputSchema Json?

  category String?

  source AgentSource @default(FIRST_PARTY)

  endpointUrl String?

  visibility AgentVisibility @default(PUBLIC)

  creatorId String?
  creator   User?   @relation(fields: [creatorId], references: [id], onDelete: SetNull)

  publishedAt DateTime?

  isActive Boolean @default(true)

  runs               Run[]
  orchestrationSteps OrchestrationStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Run {
  id     String    @id @default(cuid())
  status RunStatus @default(PENDING)

  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  result Json?

  startedAt   DateTime?
  completedAt DateTime?

  orchestrationStep OrchestrationStep?

  createdAt DateTime @default(now())

  events TraceEvent[]
}

model TraceEvent {
  id       String         @id @default(cuid())
  type     TraceEventType
  message  String
  metadata Json?

  runId String
  run   Run    @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model OrchestrationRun {
  id      String              @id @default(cuid())
  goal    String
  status  OrchestrationStatus @default(PLANNING)
  summary String?
  plan    Json?
  context Json?
  result  Json?

  state        Json?
  stateVersion Int   @default(0)

  unresolvedCapabilities String[] @default([])

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  steps  OrchestrationStep[]
  events OrchestrationEvent[]

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt
}

model OrchestrationStep {
  id String @id @default(cuid())

  orchestrationId String
  orchestration   OrchestrationRun @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  kind OrchestrationStepKind @default(AGENT)

  agentId String?
  agent   Agent?  @relation(fields: [agentId], references: [id], onDelete: SetNull)

  actionName String?

  runId String? @unique
  run   Run?    @relation(fields: [runId], references: [id], onDelete: SetNull)

  position Int

  iteration Int @default(0)

  dependsOnPositions Int[] @default([])

  status OrchestrationStepStatus @default(PENDING)

  satisfies            String[] @default([])
  requiredCapabilities String[] @default([])
  optionalCapabilities String[] @default([])

  input  Json?
  result Json?
  error  String?

  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@unique([orchestrationId, position])
}

enum OrchestrationStepKind {
  AGENT
  ACTION
}

model OrchestrationEvent {
  id String @id @default(cuid())

  type OrchestrationEventType

  message String

  metadata Json?

  orchestrationId String
  orchestration   OrchestrationRun @relation(fields: [orchestrationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

enum AgentSource {
  FIRST_PARTY
  REMOTE
}

enum AgentVisibility {
  PUBLIC
  PRIVATE
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum TraceEventType {
  RUN_STARTED
  AGENT_STARTED
  TOOL_CALLED
  TOOL_COMPLETED
  LLM_STARTED
  LLM_COMPLETED
  RUN_COMPLETED
  ERROR
}

enum OrchestrationStatus {
  PLANNING
  BLOCKED
  READY
  RUNNING
  EVALUATING
  REPLANNING
  SUCCESS
  FAILED
  CANCELLED
}

enum OrchestrationStepStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
  SKIPPED
}

enum OrchestrationEventType {
  PLAN_CREATED
  AGENT_SELECTED
  ORCHESTRATION_STARTED
  STEP_STARTED
  STEP_COMPLETED
  STEP_FAILED
  ORCHESTRATION_COMPLETED
  ORCHESTRATION_FAILED
}

model ApiKey {
  id String @id @default(cuid())

  name    String
  prefix  String
  keyHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastUsedAt DateTime?
  revokedAt  DateTime?
  encryptedKey  String?
encryptionIv  String?
encryptionTag String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
